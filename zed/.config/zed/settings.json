{
  "agent": {
    "dock": "left",
    "tool_permissions": {
      "tools": {
        "fetch": {
          "always_allow": [
            {
              "pattern": "^https?://www\\.storyblok\\.com"
            }
          ]
        }
      }
    },
    "default_profile": "ask",
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6",
      "enable_thinking": true,
      "effort": "high"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "buffer_font_size": 18.0,
  "buffer_font_weight": 400.0,
  "buffer_line_height": "comfortable",
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "icon_theme": "Catppuccin Macchiato",
  "languages": {
    "Rust": {
      "format_on_save": "on"
    },
    "JavaScript": {
      "format_on_save": "on"
    },
    "TypeScript": {
      "format_on_save": "on"
    },
    "TSX": {
      "format_on_save": "on"
    }
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy"
        }
      }
    }
  },
  "outline_panel": {
    "dock": "right"
  },
  "project_panel": {
    "dock": "right"
  },
  "theme": "Tokyoppuccin Storm",
  // Match nvim/ghostty chrome bg (#222436): every Storm surface that ships
  // as the theme's base #24283b, remapped. Delta only — rest of theme intact.
  "experimental.theme_overrides": {
    "background": "#222436",
    "editor.background": "#222436",
    "editor.gutter.background": "#222436",
    "editor.subheader.background": "#222436",
    "terminal.background": "#222436",
    "panel.background": "#222436",
    "toolbar.background": "#222436",
    "status_bar.background": "#222436",
    "title_bar.background": "#222436",
    "title_bar.inactive_background": "#222436",
    "elevated_surface.background": "#222436",
    "border.variant": "#222436",
    "border.transparent": "#222436",
    "border.disabled": "#222436"
  },
  "ui_font_size": 16,
  "vim_mode": true
}
