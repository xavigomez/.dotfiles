# Zsh ephemeral files
.zsh_history
.zcompdump*
.zsh_sessions/

# macOS
.DS_Store
.CFUserTextEncoding

# Editor temp files
.swp
.swo
*~

# IDE
.idea/
.vscode/

# Python
__pycache__/
*.pyc

# Node
node_modules/
npm-debug.log

# Environment
.env
.env.local

# spotify-player (real config has client_id, only example is versioned)
spotify-player/.config/spotify-player/app.toml
spotify-player/.config/spotify-player/.cache/
spotify-player/.config/spotify-player/credentials.json

# Tool-managed auth/credentials state — must never be tracked
**/auth.json
**/credentials.json
**/.env
**/.env.local

# pi: everything under ~/.pi/agent/ is tool-managed (auth, runtime state,
# downloaded binaries). Only pi/.pi/settings.json (skills config) is tracked.
pi/.pi/agent/

# opencode: tool-managed install footprint lives in the same dir as the config
opencode/.config/opencode/node_modules/
opencode/.config/opencode/bun.lock
opencode/.config/opencode/package.json
opencode/.config/opencode/package-lock.json

# herdr: runtime/machine-managed state under ~/.config/herdr.
# Only config.toml is versioned under this tree.
herdr/.config/herdr/plugins/
herdr/.config/herdr/plugins.json
herdr/.config/herdr/session.json
herdr/.config/herdr/*.log
herdr/.config/herdr/*.sock
herdr/.config/herdr/release-notes.json
herdr/.config/herdr/.plugins.lock
